# Entity: health

main: kit: entity: health: {

  alias: field: {}

  fields: [
    {
      name: "redis"
      req: true
      short: "true wenn Redis erreichbar (Ping erfolgreich)"
      type: "`$BOOLEAN`"
    }
    {
      name: "status"
      req: true
      type: "`$STRING`"
    }
    {
      name: "version"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "health"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/v1/health"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "health"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
