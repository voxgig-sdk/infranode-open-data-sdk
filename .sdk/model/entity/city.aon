          contract: {
            id: "GET /api/v1/cities/{slug}/transit"
            json: "{\"operationId\":\"getCityTransit\",\"parameters\":[{\"in\":\"path\",\"name\":\"slug\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Case-insensitiver Substring-Filter auf den Haltestellennamen (stop_name), z.B. alsterdorf.\",\"in\":\"query\",\"name\":\"q\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"\\\"lat,lon\\\"; liefert nur Haltestellen im Umkreis, aufsteigend nach Distanz sortiert. Ungültige Werte -> 400.\",\"in\":\"query\",\"name\":\"near\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Suchradius für near in Metern (Default 1000).\",\"in\":\"query\",\"name\":\"radius_m\",\"required\":false,\"schema\":{\"default\":1000,\"type\":\"integer\"}},{\"description\":\"Seitennummer der Default-Paginierung ohne q/near (Default 50 Einträge, Cap 200); meta.pagination weist total/returned/limit/offset/truncated aus.\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Einträge pro Seite der Default-Paginierung ohne q/near (Default 50, Cap 200).\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"data\":{\"oneOf\":[{\"items\":{\"properties\":{\"ags\":{\"description\":\"Amtlicher Gemeindeschlüssel als Join-Key (kein Pfadsegment).\",\"nullable\":true,\"type\":\"string\"},\"attribution\":{\"properties\":{\"license_url\":{\"nullable\":true,\"type\":\"string\"},\"modified\":{\"default\":false,\"type\":\"boolean\"},\"text\":{\"example\":\"Wikidata\",\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"},\"city_slug\":{\"type\":\"string\"},\"content_hash\":{\"description\":\"Deterministischer Dedup-Hash der Nutzdaten (computed, immer im Dump).\",\"type\":\"string\"},\"geo\":{\"nullable\":true,\"properties\":{\"lat\":{\"type\":\"number\"},\"lon\":{\"type\":\"number\"}}