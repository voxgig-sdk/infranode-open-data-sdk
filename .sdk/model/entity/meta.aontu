      r: true
      t: "`$STRING`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      t: "`$BOOLEAN`"
    }
    source: {
      h: "Source"
      n: "source"
      r: true
      t: "`$STRING`"
    }
  }

  name: "meta"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/sources"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "if_none_match"
                or: "if_none_match"
                r: false
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 50
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "asc"
                k: "query"
                n: "order"
                or: "order"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/sources"
          q: {
            exist: [
              "if_none_match"
              "limit"
              "offset"
              "order"
              "page"
              "sort"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "sources"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.meta`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v1/openapi.yaml"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v1/openapi.yaml"
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "openapi.yaml"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
